{
  "name": "drunk-cat-stack",
  "version": "0.0.0",
  "private": true,
  "description": "Copyable maintained-tool configuration for deterministic code-structure rules",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.21.0",
    "npm": ">=11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "pins": "node scripts/check-exact-pins.mjs",
    "env:check": "varlock load",
    "biome": "biome check .",
    "lint": "eslint .",
    "typecheck": "tsc --project tsconfig.json",
    "deps": "depcruise --config .dependency-cruiser.cjs .",
    "check": "npm run pins && npm run env:check && npm run biome && npm run lint && npm run typecheck && npm run deps",
    "test": "node --test \"tests/**/*.test.mjs\" && vitest run",
    "acceptance": "bash scripts/acceptance-cold-clone.sh",
    "prepare": "effect-tsgo patch && lefthook install",
    "vendor:agent-sources": "bash scripts/vendor-agent-sources.sh"
  },
  "dependencies": {
    "effect": "4.0.0-rc.117"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@effect/tsgo": "0.45.0",
    "@effect/vitest": "4.0.0-rc.117",
    "@swc/core": "1.16.2",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "eslint-plugin-codebase-ai-rules": "github:JakubSzwajka/eslint-plugin-codebase-ai-rules#012daeb0d1809f0e026b9425dddc9a42a77c3328",
    "lefthook": "2.1.14",
    "typescript": "7.0.2",
    "varlock": "1.20.0",
    "vitest": "5.0.1"
  },
  "overrides": {
    "eslint-plugin-codebase-ai-rules": {
      "typescript": "6.0.3"
    }
  }
}
