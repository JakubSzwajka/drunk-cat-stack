{
  "name": "codebase-ai-rules",
  "version": "0.0.0",
  "private": true,
  "description": "Copyable maintained-tool configuration for deterministic code-structure rules",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "format": "biome format --write .",
    "biome": "biome check .",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "deps": "depcruise --config .dependency-cruiser.cjs .",
    "check": "npm run biome && npm run typecheck && npm run deps"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "dependency-cruiser": "18.4.0",
    "typescript": "6.0.3"
  }
}
